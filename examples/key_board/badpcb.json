{
 "_comment": "Example badpcb project config for the key_board case study: copy next to key_board_placed.kicad_pcb (or edit the paths). Relative paths are relative to this file.",
 "board": "key_board_placed.kicad_pcb",
 "rules": {
  "project": "key_board_placed.kicad_pro"
 },
 "mcu": "U1",
 "fine_pitch_parts": [
  "U1"
 ],
 "swaps": "swaps.json",
 "locks": {
  "classes": {
   "lane": {"file": "lanes.json", "protect": true, "trim": true},
   "mimic": {"file": "mimic.json", "key": "copied"}
  },
  "trim": {
   "nets": "^(EN|SENSE)\\d+$",
   "key_parts": "^U1\\d\\d$",
   "start_part": "U1",
   "band_depth": 5.0
  }
 },
 "krt": {
  "dir": "/path/to/KiCadRoutingTools",
  "python": "/path/to/KiCadRoutingTools/.venv/bin/python"
 }
}